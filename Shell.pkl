import "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Config.pkl" as Config
import "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Builtins.pkl"

shellSteps = new Mapping<String, Config.Step> {
  ["shfmt"] = (Builtins.shfmt) {
    match_any = List(
      new Config.FileSelector { glob = List("**/*.sh", "**/*.bash") },
    )
  }
  ["shellcheck"] = (Builtins.shellcheck) {
    depends = List("shfmt")
  }
}
