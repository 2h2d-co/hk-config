import "package://github.com/jdx/hk/releases/download/v2.10.0/hk@2.10.0#/Config.pkl" as Config
import "package://github.com/jdx/hk/releases/download/v2.10.0/hk@2.10.0#/Builtins.pkl"

gitHubActionsSteps = new Mapping<String, Config.Step> {
  ["jactionlint"] = Builtins.jactionlint
  ["zizmor"] = (Builtins.zizmor) {
    check { command = "zizmor --no-progress --pedantic --no-ignores {{ files }}" }
    fix { command = "zizmor --no-progress --pedantic --no-ignores --fix {{ files }}" }
  }
}
