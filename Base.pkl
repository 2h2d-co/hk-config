import "package://github.com/jdx/hk/releases/download/v1.54.1/hk@1.54.1#/Config.pkl" as Config
import "package://github.com/jdx/hk/releases/download/v1.54.1/hk@1.54.1#/Builtins.pkl"

// Show when conditional steps are skipped because profiles or command/file conditions do not match.
displaySkipReasons = List("profile-not-enabled", "condition-false")

function commandExistsCondition(command: String): String =
  "exec('command -v \(command) >/dev/null 2>&1; echo $?') == '0\n'"

function commandMissingCondition(command: String): String =
  "exec('command -v \(command) >/dev/null 2>&1; echo $?') != '0\n'"

function optionalCommand(command: String, step: Config.Step): Config.Step =
  (step) {
    step_condition = commandExistsCondition(command)
  }

function fileExistsCondition(file: String): String =
  "exec('test -f \"\(file)\"; echo $?') == '0\n'"

function whenFileExists(file: String, step: Config.Step): Config.Step =
  (step) {
    step_condition = fileExistsCondition(file)
  }

conventionalCommitTypes = "build,chore,ci,docs,feat,fix,perf,refactor,revert,style,test,release"

literalEscapeSequencesInCommitMessage = new Config.Step {
  check = #"""
    if LC_ALL=C grep -Fq '\n' "{{commit_msg_file}}"; then
      printf '%s\n' "commit messages must not contain literal \\n sequences; use multiple -m arguments or ANSI-C shell quoting (\$'...\\n...') for newlines" >&2
      exit 1
    fi
    if LC_ALL=C grep -Eq '\\.' "{{commit_msg_file}}"; then
      printf '%s\n' 'commit messages must not contain literal escape sequences; use the intended characters instead' >&2
      exit 1
    fi
    """#
}

lightweightReleaseTagsAtHead = new Config.Step {
  check = #"""
    git rev-parse --verify HEAD >/dev/null 2>&1 || exit 0
    git for-each-ref --points-at=HEAD --format='%(refname) %(objecttype)' refs/tags |
      while IFS=' ' read -r ref object_type; do
        printf '%s\n' "$ref" | grep -Eq '^refs/tags/v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$' || continue
        if [ "$object_type" != commit ]; then
          echo "release tag ${ref#refs/tags/} must be a lightweight tag; create release tags with 'git tag <tag>' without -a, -s, or -m" >&2
          exit 1
        fi
      done
    """#
}

lightweightReleaseTagsPrePush = new Config.Step {
  stdin = "{{ hook_stdin }}"
  check = #"""
    while IFS=' ' read -r _local_ref local_oid remote_ref _remote_oid; do
      printf '%s\n' "$remote_ref" | grep -Eq '^refs/tags/v[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$' || continue
      printf '%s\n' "$local_oid" | grep -Eq '^0+$' && continue
      object_type=$(git cat-file -t "$local_oid")
      if [ "$object_type" != commit ]; then
        echo "release tag ${remote_ref#refs/tags/} must be a lightweight tag; create release tags with 'git tag <tag>' without -a, -s, or -m" >&2
        exit 1
      fi
    done
    """#
}

commitMessageSteps = new Mapping<String, Config.Step> {
  ["literal-escape-sequences"] = literalEscapeSequencesInCommitMessage
  ["cocogitto-commit-msg"] = optionalCommand("cog", Builtins.cocogitto_commit_msg)
  ["check-conventional-commit"] = (Builtins.check_conventional_commit) {
    step_condition = commandMissingCondition("cog")
    check = "hk util check-conventional-commit --allowed-types=\(conventionalCommitTypes) \"{{commit_msg_file}}\""
  }
}

function defaultHooks(
  autofix: Boolean,
  projectSteps: Mapping<String, Config.Step>,
): Mapping<String, Config.Hook> =
  new Mapping<String, Config.Hook> {
    ["pre-commit"] {
      fix = autofix
      stash = "git"
      steps = (projectSteps) {
        ["lightweight-release-tags"] = lightweightReleaseTagsAtHead
      }
    }
    ["pre-push"] {
      steps = (projectSteps) {
        ["lightweight-release-tags"] = lightweightReleaseTagsPrePush
      }
    }
    ["commit-msg"] {
      steps = commitMessageSteps
    }
    ["fix"] {
      fix = true
      steps = projectSteps
    }
    ["check"] {
      steps = projectSteps
    }
  }

baseSteps = new Mapping<String, Config.Step> {
  ["check-added-large-files"] = Builtins.check_added_large_files
  ["check-case-conflict"] = Builtins.check_case_conflict
  ["check-executables-have-shebangs"] = Builtins.check_executables_have_shebangs
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["check-symlinks"] = Builtins.check_symlinks
  ["byte-order-marker"] = Builtins.byte_order_marker
  ["mixed-line-ending"] = Builtins.mixed_line_ending
  ["newlines"] = Builtins.newlines
  ["trailing-whitespace"] = Builtins.trailing_whitespace
  ["detect-private-key"] = Builtins.detect_private_key

  ["betterleaks"] = optionalCommand("betterleaks", new Config.Step {
    types = List("text")
    batch = true
    check = "betterleaks dir --redact --verbose --no-banner {{files}}"
  })
  ["mise-installed"] {
    step_condition = fileExistsCondition("mise.toml")
    check = "mise --version >/dev/null 2>&1"
  }
  ["mise"] = (whenFileExists("mise.toml", Builtins.mise)) {
    depends = List("mise-installed")
  }
}
