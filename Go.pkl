import "package://github.com/jdx/hk/releases/download/v1.56.0/hk@1.56.0#/Config.pkl" as Config
import "package://github.com/jdx/hk/releases/download/v1.56.0/hk@1.56.0#/Builtins.pkl"
import "./Base.pkl" as Base

goSteps = new Mapping<String, Config.Step> {
  ["go-imports"] = Base.optionalCommand("goimports", Builtins.go_imports)
  ["go-fmt"] = (Base.optionalCommand("gofmt", Builtins.go_fmt)) {
    depends = List("go-imports")
  }
  ["gomod-tidy"] = Base.optionalCommand("go", Builtins.gomod_tidy)
  ["go-vet"] = (Base.optionalCommand("go", Builtins.go_vet)) {
    depends = List("go-fmt", "gomod-tidy")
  }
  ["golangci-lint"] = (Base.optionalCommand("golangci-lint", Builtins.golangci_lint)) {
    depends = List("go-fmt", "gomod-tidy")
  }
  ["go-vuln-check"] = new Config.Step {
    glob = List("**/*.go", "**/go.mod", "**/go.sum")
    workspace_indicator = "go.mod"
    step_condition = Base.commandExistsCondition("go")
    depends = List("go-vet")
    check = new Config.CommandSpec {
      command = #"""
        cd {{workspace}}
        if ! go tool | grep -Fxq 'golang.org/x/vuln/cmd/govulncheck'; then
          echo 'govulncheck must be declared as a Go tool dependency' >&2
          echo 'run: go get -tool golang.org/x/vuln/cmd/govulncheck@v1.7.0' >&2
          exit 1
        fi
        go tool govulncheck ./...
        """#
      effect = "write"
    }
  }
}
